diff --git a/ggml/include/ggml-cpu.h b/ggml/include/ggml-cpu.h
index e3e067c91..946d1877f 100644
--- a/ggml/include/ggml-cpu.h
+++ b/ggml/include/ggml-cpu.h
@@ -69,6 +69,23 @@ extern "C" {
                     struct ggml_threadpool * threadpool /* = NULL */ );
     GGML_BACKEND_API enum ggml_status  ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cplan * cplan);
 
+    enum ggml_cpu_stage_profile_stage {
+        GGML_CPU_STAGE_PROFILE_ATTENTION = 0,
+        GGML_CPU_STAGE_PROFILE_FFN_GATE_UP,
+        GGML_CPU_STAGE_PROFILE_FFN_DOWN,
+        GGML_CPU_STAGE_PROFILE_LOGITS,
+        GGML_CPU_STAGE_PROFILE_COUNT,
+    };
+
+    struct ggml_cpu_stage_profile_snapshot {
+        uint64_t microseconds[GGML_CPU_STAGE_PROFILE_COUNT];
+        uint64_t segments[GGML_CPU_STAGE_PROFILE_COUNT];
+    };
+
+    GGML_BACKEND_API void ggml_cpu_stage_profile_set_enabled(bool enabled);
+    GGML_BACKEND_API void ggml_cpu_stage_profile_reset(void);
+    GGML_BACKEND_API void ggml_cpu_stage_profile_get_snapshot(struct ggml_cpu_stage_profile_snapshot * snapshot);
+
     // same as ggml_graph_compute() but the work data is allocated as a part of the context
     // note: the drawback of this API is that you must have ensured that the context has enough memory for the work data
     GGML_BACKEND_API enum ggml_status  ggml_graph_compute_with_ctx(struct ggml_context * ctx, struct ggml_cgraph * cgraph, int n_threads);
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 7b05edf6b..945bf77f4 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3008,6 +3008,64 @@ static int ggml_cpu_try_fuse_ops(
     return 0;
 }
 
+static atomic_bool ggml_cpu_stage_profile_enabled = false;
+static uint64_t ggml_cpu_stage_profile_microseconds[GGML_CPU_STAGE_PROFILE_COUNT];
+static uint64_t ggml_cpu_stage_profile_segments[GGML_CPU_STAGE_PROFILE_COUNT];
+
+void ggml_cpu_stage_profile_set_enabled(bool enabled) {
+    atomic_store_explicit(&ggml_cpu_stage_profile_enabled, enabled, memory_order_release);
+}
+
+void ggml_cpu_stage_profile_reset(void) {
+    GGML_ASSERT(!atomic_load_explicit(&ggml_cpu_stage_profile_enabled, memory_order_acquire));
+    memset(ggml_cpu_stage_profile_microseconds, 0, sizeof(ggml_cpu_stage_profile_microseconds));
+    memset(ggml_cpu_stage_profile_segments, 0, sizeof(ggml_cpu_stage_profile_segments));
+}
+
+void ggml_cpu_stage_profile_get_snapshot(struct ggml_cpu_stage_profile_snapshot * snapshot) {
+    GGML_ASSERT(snapshot != NULL);
+    GGML_ASSERT(!atomic_load_explicit(&ggml_cpu_stage_profile_enabled, memory_order_acquire));
+    memcpy(snapshot->microseconds, ggml_cpu_stage_profile_microseconds, sizeof(snapshot->microseconds));
+    memcpy(snapshot->segments, ggml_cpu_stage_profile_segments, sizeof(snapshot->segments));
+}
+
+static bool ggml_cpu_stage_profile_weight_contains(const struct ggml_tensor * node, const char * needle) {
+    return node->op == GGML_OP_MUL_MAT && node->src[0] != NULL && strstr(node->src[0]->name, needle) != NULL;
+}
+
+static enum ggml_cpu_stage_profile_stage ggml_cpu_stage_profile_stage_before_node(
+        const struct ggml_tensor * node,
+        enum ggml_cpu_stage_profile_stage current) {
+    if (node->op == GGML_OP_MUL_MAT && node->src[0] != NULL && strcmp(node->src[0]->name, "output.weight") == 0) {
+        return GGML_CPU_STAGE_PROFILE_LOGITS;
+    }
+    return current;
+}
+
+static enum ggml_cpu_stage_profile_stage ggml_cpu_stage_profile_stage_after_node(
+        const struct ggml_tensor * node,
+        enum ggml_cpu_stage_profile_stage current) {
+    if (ggml_cpu_stage_profile_weight_contains(node, "attn_output")) {
+        return GGML_CPU_STAGE_PROFILE_FFN_GATE_UP;
+    }
+    if (ggml_cpu_stage_profile_weight_contains(node, "ffn_up")) {
+        return GGML_CPU_STAGE_PROFILE_FFN_DOWN;
+    }
+    if (ggml_cpu_stage_profile_weight_contains(node, "ffn_down")) {
+        return GGML_CPU_STAGE_PROFILE_ATTENTION;
+    }
+    return current;
+}
+
+static void ggml_cpu_stage_profile_close_segment(
+        enum ggml_cpu_stage_profile_stage stage,
+        int64_t * segment_start_us) {
+    const int64_t now_us = ggml_time_us();
+    ggml_cpu_stage_profile_microseconds[stage] += (uint64_t) (now_us - *segment_start_us);
+    ++ggml_cpu_stage_profile_segments[stage];
+    *segment_start_us = now_us;
+}
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3036,6 +3094,11 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+    const bool stage_profile_enabled = state->ith == 0 &&
+        atomic_load_explicit(&ggml_cpu_stage_profile_enabled, memory_order_acquire);
+    enum ggml_cpu_stage_profile_stage stage_profile_stage = GGML_CPU_STAGE_PROFILE_ATTENTION;
+    int64_t stage_profile_segment_start_us = stage_profile_enabled ? ggml_time_us() : 0;
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];
 
@@ -3048,6 +3111,15 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             continue;
         }
 
+        if (stage_profile_enabled) {
+            const enum ggml_cpu_stage_profile_stage before_stage =
+                ggml_cpu_stage_profile_stage_before_node(node, stage_profile_stage);
+            if (before_stage != stage_profile_stage) {
+                ggml_cpu_stage_profile_close_segment(stage_profile_stage, &stage_profile_segment_start_us);
+                stage_profile_stage = before_stage;
+            }
+        }
+
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
@@ -3066,6 +3138,15 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
         }
+
+        if (stage_profile_enabled) {
+            const enum ggml_cpu_stage_profile_stage after_stage =
+                ggml_cpu_stage_profile_stage_after_node(node, stage_profile_stage);
+            if (after_stage != stage_profile_stage) {
+                ggml_cpu_stage_profile_close_segment(stage_profile_stage, &stage_profile_segment_start_us);
+                stage_profile_stage = after_stage;
+            }
+        }
     }
 
 #ifdef GGML_USE_OPENMP
@@ -3076,6 +3157,10 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 
     ggml_barrier(state->threadpool);
 
+    if (stage_profile_enabled) {
+        ggml_cpu_stage_profile_close_segment(stage_profile_stage, &stage_profile_segment_start_us);
+    }
+
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
 #endif
