#!/bin/sh
set -eu

if command -v python3 >/dev/null 2>&1; then
	PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
	PYTHON="python"
elif command -v py >/dev/null 2>&1; then
	PYTHON="py -3"
else
	echo "LiteNN pre-commit hook requires python3, python, or py to run scripts/format_sources.py." >&2
	exit 1
fi

STAGED_FILE="$(mktemp)"
trap 'rm -f "$STAGED_FILE"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR > "$STAGED_FILE"

$PYTHON scripts/format_sources.py

if [ -s "$STAGED_FILE" ]; then
	xargs -0 git add -- < "$STAGED_FILE"
fi
